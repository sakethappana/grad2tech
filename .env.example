# Grad2Tech platform configuration.
# Copy to `.env` for local development. Never commit real secrets.

# ── Application ────────────────────────────────────────────────
# Public base URL of the portal (used for auth callbacks, invitation and reset links).
APP_URL=http://localhost:3000
# Default display timezone for dates (all timestamps are stored in UTC).
DISPLAY_TIMEZONE=Asia/Kolkata

# ── Database (PostgreSQL 14+) ──────────────────────────────────
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5433/grad2tech_dev
# Used only by the automated test suite. Must point at a disposable database.
TEST_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5433/grad2tech_test

# Local development database (scripts/local-db.ts runs an embedded PostgreSQL).
LOCAL_PG_PORT=5433
LOCAL_PG_PASSWORD=CHANGE_ME
LOCAL_PG_DIR=.data/postgres

# ── Authentication (Better Auth) ───────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# Session lifetime and refresh interval, in seconds.
SESSION_EXPIRES_IN=604800
SESSION_UPDATE_AGE=86400
# Stable key for Next.js Server Action encryption when running more than one instance.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# ── Code execution (Judge0) ────────────────────────────────────
# Option A: Judge0 CE through RapidAPI.
#   JUDGE0_URL=https://judge0-ce.p.rapidapi.com
#   JUDGE0_RAPIDAPI_KEY=your-key
#   JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com
# Option B: self-hosted Judge0 (on a separate, isolated Linux host).
#   JUDGE0_URL=https://judge0.internal.example.com
#   JUDGE0_AUTH_TOKEN=value-of-AUTHN_TOKEN-on-the-judge0-server
JUDGE0_URL=
JUDGE0_RAPIDAPI_KEY=
JUDGE0_RAPIDAPI_HOST=
JUDGE0_AUTH_TOKEN=
# Language ids offered in the playground (comma-separated provider language ids).
# Leave empty to offer every supported language family the provider reports.
JUDGE0_LANGUAGE_IDS=

# Per-run limits for playground runs (assessment limits are set per question).
RUN_CPU_TIME_LIMIT_S=5
RUN_WALL_TIME_LIMIT_S=10
RUN_MEMORY_LIMIT_KB=256000
RUN_MAX_OUTPUT_BYTES=65536
# Per-user quotas.
RUN_MAX_PER_MINUTE=10
RUN_MAX_PER_DAY=300
RUN_MAX_CONCURRENT=2
# Run history kept per user.
RUN_HISTORY_KEEP=50
RUN_HISTORY_DAYS=30

# ── File storage ───────────────────────────────────────────────
# local: private directory on the app server (development / single server).
# s3: any S3-compatible bucket (AWS S3, Cloudflare R2, MinIO). The bucket must be private.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Maximum upload size in bytes (default 10 MB).
UPLOAD_MAX_BYTES=10485760

# ── Email (optional) ───────────────────────────────────────────
# When unset, invitation and reset links are shown to the admin to share manually.
SMTP_URL=
EMAIL_FROM=Grad2Tech <no-reply@example.com>

# ── Full Stack Workspace ───────────────────────────────────────
# WebContainers run student projects inside the student's browser.
# Commercial (for-profit) production use requires a StackBlitz WebContainer API licence.
WEBCONTAINER_CLIENT_ID=
